#!/bin/sh
set -eu

if [ -n "${RUNTIME_DIRECTORY:-}" ]; then
    if [ -f "${RUNTIME_DIRECTORY}/uuid" ]; then
        legacy_uuid="$(tr -d ' \t\r\n' < "${RUNTIME_DIRECTORY}/uuid")"
        if [ -n "$legacy_uuid" ] && nsenter --mount=/proc/1/ns/mnt -- test -e "/run/netns/${legacy_uuid}"; then
            nsenter --mount=/proc/1/ns/mnt -- umount -l "/run/netns/${legacy_uuid}" 2>/dev/null || true
            nsenter --mount=/proc/1/ns/mnt -- rm -f "/run/netns/${legacy_uuid}" 2>/dev/null || true
        fi
    fi
    for app_mnt in "${RUNTIME_DIRECTORY}"/app-rootfs/*; do
        if [ -d "$app_mnt" ]; then
            umount -l "$app_mnt" 2>/dev/null || true
        fi
    done
    if [ -d "${RUNTIME_DIRECTORY}/stage1" ]; then
        umount -l "${RUNTIME_DIRECTORY}/stage1" 2>/dev/null || true
    fi
fi
