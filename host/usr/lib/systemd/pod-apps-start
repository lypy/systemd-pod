#!/bin/sh
set -eu

CRED_DIR="${CREDENTIALS_DIRECTORY:-/run/credentials}"
RUN_DIR="${RUNTIME_DIRECTORY:-}"

if [ ! -d "$CRED_DIR" ]; then
    echo "Credentials directory ${CRED_DIR} not accessible" >&2
    exit 1
fi

if [ -z "$RUN_DIR" ] || [ ! -f "${RUN_DIR}/machine-name" ]; then
    echo "Missing machine-name in RUNTIME_DIRECTORY" >&2
    exit 1
fi

MACHINE_NAME="$(tr -d ' \t\r\n' < "${RUN_DIR}/machine-name")"

read_first_line() {
    if [ -f "$1" ]; then
        tr -d '\r\n' < "$1"
    fi
}

start_app_cred() {
    cred="$1"
    app_id="${cred##*pod.app.}"
    spec="$(tr -d '\r\n' < "$cred")"

    image_name=""
    case "$spec" in
        *=*)
            old_ifs="$IFS"
            IFS=','
            for pair in $spec; do
                k="${pair%%=*}"
                v="${pair#*=}"
                if [ "$k" = "image" ]; then
                    image_name="$v"
                fi
            done
            IFS="$old_ifs"
            ;;
        *)
            image_name="$(printf '%s' "$spec" | tr -d ' \t')"
            ;;
    esac

    if [ -z "$image_name" ]; then
        echo "Missing image name in ${cred}" >&2
        exit 1
    fi

    img_dir="/var/lib/machines/${image_name}"

    exec_cmd="$(read_first_line "${img_dir}/etc/pod-entrypoint")"
    svc_type="$(read_first_line "${img_dir}/etc/pod-type" | tr -d ' \t')"
    svc_user="$(read_first_line "${img_dir}/etc/pod-user" | tr -d ' \t')"
    svc_group="$(read_first_line "${img_dir}/etc/pod-group" | tr -d ' \t')"
    svc_wd="$(read_first_line "${img_dir}/etc/pod-wd" | tr -d ' \t')"
    svc_caps="$(read_first_line "${img_dir}/etc/pod-caps")"

    set -- --property="EnvironmentFile=-/opt/stage2/${app_id}/rootfs/etc/pod-environment"

    case "$spec" in
        *=*)
            old_ifs="$IFS"
            IFS=','
            for pair in $spec; do
                k="${pair%%=*}"
                v="${pair#*=}"
                case "$k" in
                    exec)           exec_cmd="$v" ;;
                    type)           svc_type="$v" ;;
                    user)           svc_user="$v" ;;
                    group)          svc_group="$v" ;;
                    wd)             svc_wd="$v" ;;
                    caps)           svc_caps="$v" ;;
                    bind)           set -- "$@" --property="BindPaths=${v}" ;;
                    bind_ro)        set -- "$@" --property="BindReadOnlyPaths=${v}" ;;
                    after)          set -- "$@" --property="After=${v}" ;;
                    sup_groups)     set -- "$@" --property="SupplementaryGroups=${v}" ;;
                    ambient_caps)   set -- "$@" --property="AmbientCapabilities=${v}" ;;
                    exec_pre)       set -- "$@" --property="ExecStartPre=${v}" ;;
                    exec_post)      set -- "$@" --property="ExecStartPost=${v}" ;;
                    exec_stop)      set -- "$@" --property="ExecStopPost=${v}" ;;
                    memory_max)     set -- "$@" --property="MemoryMax=${v}" ;;
                    memory_high)    set -- "$@" --property="MemoryHigh=${v}" ;;
                    cpu_quota)      set -- "$@" --property="CPUQuota=${v}" ;;
                    cpu_weight)     set -- "$@" --property="CPUWeight=${v}" ;;
                    tasks_max)      set -- "$@" --property="TasksMax=${v}" ;;
                    syscall_filter) set -- "$@" --property="SystemCallFilter=${v}" ;;
                    env)            set -- "$@" --property="Environment=${v}" ;;
                esac
            done
            IFS="$old_ifs"
            ;;
    esac

    if [ -z "$exec_cmd" ]; then
        echo "No exec= specified in ${cred} and no /etc/pod-entrypoint found in ${img_dir}" >&2
        exit 1
    fi

    if [ -n "$svc_type" ]; then
        set -- "$@" --property="Type=${svc_type}"
        if [ "$svc_type" = "notify" ] || [ "$svc_type" = "notify-reload" ]; then
            set -- "$@" --property=NotifyAccess=all
        fi
    fi
    if [ -n "$svc_user" ]; then
        set -- "$@" --property="User=${svc_user}"
    fi
    if [ -n "$svc_group" ]; then
        set -- "$@" --property="Group=${svc_group}"
    fi
    if [ -n "$svc_wd" ]; then
        set -- "$@" --property="WorkingDirectory=${svc_wd}"
    fi
    if [ -n "$svc_caps" ]; then
        set -- "$@" --property="CapabilityBoundingSet=${svc_caps}"
    fi

    # shellcheck disable=SC2086
    /usr/bin/systemd-run --machine="${MACHINE_NAME}" \
        --collect \
        --unit="${app_id}.service" \
        --property=Restart=always \
        --property=RestartSec=2s \
        --property=MountAPIVFS=yes \
        --property=ProtectHostname=yes \
        --property="LogExtraFields=POD_UNIT=${MACHINE_NAME}" \
        --property="RootDirectory=/opt/stage2/${app_id}/rootfs" \
        "$@" \
        $exec_cmd
}

deps_ready() {
    cred="$1"
    spec="$(tr -d '\r\n' < "$cred")"
    case "$spec" in
        *=*)
            old_ifs="$IFS"
            IFS=','
            for pair in $spec; do
                k="${pair%%=*}"
                v="${pair#*=}"
                if [ "$k" = "after" ]; then
                    IFS=' '
                    for dep in $v; do
                        case "$all_units" in
                            *,"${dep}",*)
                                case "$started_units" in
                                    *,"${dep}",*) ;;
                                    *)
                                        IFS="$old_ifs"
                                        return 1
                                        ;;
                                esac
                                ;;
                        esac
                    done
                    IFS=','
                fi
            done
            IFS="$old_ifs"
            ;;
    esac
    return 0
}

all_units=","
for cred in "${CRED_DIR}"/pod.app.*; do
    if [ ! -f "$cred" ]; then
        continue
    fi
    app_id="${cred##*pod.app.}"
    all_units="${all_units}${app_id}.service,"
done

started_units=","
progress=1
while [ "$progress" -eq 1 ]; do
    progress=0
    for cred in "${CRED_DIR}"/pod.app.*; do
        if [ ! -f "$cred" ]; then
            continue
        fi
        app_id="${cred##*pod.app.}"
        case "$started_units" in
            *,"${app_id}.service",*) continue ;;
        esac
        if deps_ready "$cred"; then
            start_app_cred "$cred"
            started_units="${started_units}${app_id}.service,"
            progress=1
        fi
    done
done

for cred in "${CRED_DIR}"/pod.app.*; do
    if [ ! -f "$cred" ]; then
        continue
    fi
    app_id="${cred##*pod.app.}"
    case "$started_units" in
        *,"${app_id}.service",*) continue ;;
    esac
    start_app_cred "$cred"
    started_units="${started_units}${app_id}.service,"
done

/usr/bin/systemctl --machine="${MACHINE_NAME}" restart pod-os-release-sync.service 2>/dev/null || true
