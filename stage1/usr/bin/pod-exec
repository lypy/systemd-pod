#!/bin/sh
set -eu

if [ "$#" -lt 2 ]; then
    echo "Usage: pod-exec <app> <command> [args...]" >&2
    exit 1
fi

app="${1%.service}"
shift

pid="$(systemctl show --property=MainPID --value "${app}.service" 2>/dev/null || true)"
if [ -z "$pid" ] || [ "$pid" = "0" ] || [ ! -d "/proc/${pid}" ] || [ ! -e "/proc/${pid}/root" ] || [ "/proc/${pid}/root" -ef / ]; then
    echo "Stage 2 application '${app}' is not running" >&2
    exit 1
fi

exec /usr/bin/nsenter --target="$pid" --mount --uts --ipc --net --pid --root --wd -- "$@"
