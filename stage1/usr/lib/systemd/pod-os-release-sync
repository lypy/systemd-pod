#!/bin/sh
set -eu

exec 9>/run/pod-os-release-sync.lock
flock 9

apps=""
seen_imgs=","
version_id=""

cgroup_slice=""
if [ -d /sys/fs/cgroup/system.slice ]; then
    cgroup_slice="/sys/fs/cgroup/system.slice"
elif [ -d /sys/fs/cgroup/systemd/system.slice ]; then
    cgroup_slice="/sys/fs/cgroup/systemd/system.slice"
fi

if [ -n "$cgroup_slice" ]; then
    for unit_dir in "${cgroup_slice}"/*.service; do
        if [ ! -d "$unit_dir" ]; then
            continue
        fi
        unit_name="${unit_dir##*/}"
        case "$unit_name" in
            dbus.service|systemd-*|container-*|pod-os-release-*|pod-stage2-post@*|pod-stdio@*|run-*.service) continue ;;
        esac

        pid=""
        if [ -r "${unit_dir}/cgroup.procs" ]; then
            while IFS= read -r cand_pid; do
                if [ -n "$cand_pid" ] && [ -e "/proc/${cand_pid}/root" ] && [ ! "/proc/${cand_pid}/root" -ef / ]; then
                    pid="$cand_pid"
                    break
                fi
            done < "${unit_dir}/cgroup.procs" 2>/dev/null || true
        fi
        if [ -z "$pid" ]; then
            continue
        fi

        app_id=""
        cand="${unit_name%.service}"
        if [ -d "/opt/stage2/${cand}/rootfs" ] && [ "/proc/${pid}/root" -ef "/opt/stage2/${cand}/rootfs" ]; then
            app_id="$cand"
        fi

        if [ -z "$app_id" ]; then
            for stage2_dir in /opt/stage2/*/rootfs; do
                if [ -d "$stage2_dir" ] && [ "/proc/${pid}/root" -ef "$stage2_dir" ]; then
                    tmp="${stage2_dir#/opt/stage2/}"
                    app_id="${tmp%/rootfs}"
                    break
                fi
            done
        fi

        if [ -z "$app_id" ]; then
            continue
        fi

        root_dir="/opt/stage2/${app_id}/rootfs"
        if [ -f "/opt/stage2/${app_id}/image" ]; then
            img_name="$(tr -d ' \t\r\n' < "/opt/stage2/${app_id}/image")"
        else
            img_name="$app_id"
        fi

        case "$seen_imgs" in
            *,"${img_name}",*) ;;
            *)
                seen_imgs="${seen_imgs}${img_name},"
                if [ -z "$apps" ]; then
                    apps="$img_name"
                else
                    apps="${apps},${img_name}"
                fi
                ;;
        esac

        if [ -z "$version_id" ] && [ -f "${root_dir}/etc/os-release" ]; then
            version_id="$(sed -n 's/^VERSION_ID=//p' "${root_dir}/etc/os-release" | tr -d '"' | head -n 1)"
        fi
    done
fi

pretty_name="Debian GNU/Linux"
os_name="Debian GNU/Linux"
if [ -f /usr/lib/os-release ]; then
    p="$(sed -n 's/^PRETTY_NAME=//p' /usr/lib/os-release | tr -d '"' | head -n 1)"
    n="$(sed -n 's/^NAME=//p' /usr/lib/os-release | tr -d '"' | head -n 1)"
    if [ -n "$p" ]; then
        pretty_name="$p"
    fi
    if [ -n "$n" ]; then
        os_name="$n"
    fi
fi

tmp_file="/etc/os-release.tmp.$$"
if [ -n "$apps" ]; then
    cat > "${tmp_file}" << EOR
PRETTY_NAME="${pretty_name}"
NAME="${os_name}"
ID="${apps}"
VERSION_ID="${version_id}"
EOR
    mv -f "${tmp_file}" /etc/os-release
elif [ -f /usr/lib/os-release ]; then
    cp /usr/lib/os-release "${tmp_file}"
    mv -f "${tmp_file}" /etc/os-release
else
    cat > "${tmp_file}" << EOR
PRETTY_NAME="${pretty_name}"
NAME="${os_name}"
EOR
    mv -f "${tmp_file}" /etc/os-release
fi
